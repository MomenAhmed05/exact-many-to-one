{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://example.invalid/promotion-manifest.schema.json",
 "title": "Promotion manifest",
 "description": "The object a desk locks BEFORE it looks at evaluation-period performance. Everything the familywise guarantee depends on is named here, so that whether the guarantee applies is a question about a file rather than about what someone remembers doing.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "manifest_version",
  "locked_at",
  "locked_by",
  "benchmark",
  "candidates",
  "returns",
  "window",
  "hypothesis",
  "dependence",
  "nuisance_domain",
  "threshold_table",
  "specifications"
 ],
 "properties": {
  "manifest_version": {"const": 1},
  "locked_at": {
   "type": "string",
   "format": "date-time",
   "description": "When the family was fixed. Must precede window.evaluation_end, or the test is a screen and not a discovery-valid guarantee."
  },
  "locked_by": {"type": "string", "minLength": 1},
  "note": {"type": "string"},

  "benchmark": {
   "type": "object",
   "additionalProperties": false,
   "required": ["id", "code_sha256"],
   "properties": {
    "id": {"type": "string", "minLength": 1},
    "code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "description": {"type": "string"}
   }
  },

  "candidates": {
   "type": "array",
   "minItems": 1,
   "description": "The FULL declared family. Adding a member after locked_at voids the guarantee; removing one does not, but must be recorded in amendments.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "code_sha256"],
    "properties": {
     "id": {"type": "string", "minLength": 1},
     "code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "description": {"type": "string"}
    }
   }
  },

  "returns": {
   "type": "object",
   "additionalProperties": false,
   "required": ["frequency", "cost_model", "rebalance", "missing_data_policy"],
   "properties": {
    "frequency": {"enum": ["daily", "weekly", "monthly", "quarterly"]},
    "cost_model": {
     "type": "object",
     "additionalProperties": false,
     "required": ["commission_bp", "slippage_bp", "financing"],
     "properties": {
      "commission_bp": {"type": "number", "minimum": 0},
      "slippage_bp": {"type": "number", "minimum": 0},
      "financing": {"type": "string"},
      "source": {"type": "string"}
     }
    },
    "rebalance": {"type": "string", "minLength": 1},
    "missing_data_policy": {
     "enum": ["drop_period", "carry_forward", "zero_return", "reject_run"]
    }
   }
  },

  "window": {
   "type": "object",
   "additionalProperties": false,
   "required": ["evaluation_start", "evaluation_end"],
   "properties": {
    "research_end": {
     "type": "string", "format": "date",
     "description": "Last date used for hypothesis generation and tuning."
    },
    "calibration_start": {"type": "string", "format": "date"},
    "calibration_end": {
     "type": "string", "format": "date",
     "description": "Required when any dependence tier is B. Must not overlap the evaluation window."
    },
    "evaluation_start": {"type": "string", "format": "date"},
    "evaluation_end": {"type": "string", "format": "date"}
   }
  },

  "hypothesis": {
   "type": "object",
   "additionalProperties": false,
   "required": ["direction", "fwer_target", "statistic"],
   "properties": {
    "direction": {"enum": ["one_sided_greater", "two_sided"]},
    "fwer_target": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
    "statistic": {"enum": ["welch_separate_variance"]},
    "estimand": {
     "enum": ["raw_mean_difference", "factor_alpha_difference"],
     "description": "Residualising against a factor changes the estimand. It must be declared as a change of question, not as a pre-processing detail."
    }
   }
  },

  "dependence": {
   "type": "object",
   "additionalProperties": false,
   "required": ["serial", "cross_sectional"],
   "properties": {
    "serial": {
     "type": "object",
     "additionalProperties": false,
     "required": ["tier"],
     "properties": {
      "tier": {
       "enum": ["none", "A_declared", "B_calibration_period", "C_same_period"],
       "description": "A carries the certificate. B carries a conditional interpretation. C carries neither and must be reported as a plug-in."
      },
      "transform": {"enum": ["cochrane_orcutt", "prais_winsten"]},
      "phi": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1},
      "phi_max": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1},
      "source": {"type": "string"}
     }
    },
    "cross_sectional": {
     "type": "object",
     "additionalProperties": false,
     "required": ["tier", "model"],
     "properties": {
      "tier": {"enum": ["none", "A_declared", "B_calibration_period", "C_same_period"]},
      "model": {
       "enum": ["independent_groups", "observed_factor", "latent_factor"],
       "description": "independent_groups asserts the groups do not share dates or shocks. For a desk panel observed on common dates that assertion is usually false."
      },
      "loadings": {"type": "array", "items": {"type": "number"}},
      "loading_contrast_domain": {
       "type": "array", "minItems": 2, "maxItems": 2,
       "items": {"type": "number"}
      },
      "source": {"type": "string"}
     }
    }
   }
  },

  "nuisance_domain": {
   "type": "object",
   "additionalProperties": false,
   "required": ["variance_ratio", "source"],
   "properties": {
    "variance_ratio": {
     "type": "array", "minItems": 2, "maxItems": 2,
     "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "source": {
     "enum": [
      "published_volatility_target",
      "contractual_risk_limit",
      "construction_constraint",
      "disjoint_prior_period",
      "same_returns_being_tested"
     ],
     "description": "same_returns_being_tested is circular and voids the guarantee. It is an allowed value so that a manifest can record the truth and the verifier can refuse it, rather than tempting the author to write something else."
    },
    "evidence": {"type": "string"}
   }
  },

  "threshold_table": {
   "type": "object",
   "additionalProperties": false,
   "required": ["version", "sha256", "alpha0"],
   "properties": {
    "version": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "alpha0": {"type": "number", "exclusiveMinimum": 0},
    "certificate_deposit": {"type": "string"},
    "certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   }
  },

  "specifications": {
   "type": "object",
   "additionalProperties": false,
   "required": ["primary"],
   "properties": {
    "primary": {"type": "string", "minLength": 1},
    "sensitivity": {"type": "array", "items": {"type": "string"}}
   }
  },

  "amendments": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["at", "by", "change", "reason"],
    "properties": {
     "at": {"type": "string", "format": "date-time"},
     "by": {"type": "string"},
     "change": {"type": "string"},
     "reason": {"type": "string"}
    }
   }
  }
 }
}
