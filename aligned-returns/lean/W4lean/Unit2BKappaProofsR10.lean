import W4lean.Unit2BFormalR1
import W4lean.Unit2BKappaStatementR1

/-
The proof of `kappa_reduction` produced in a separate Lean project (namespace `KappaInd`),
ported into this project against the PROJECT's own definitions.

GENERATED by a port script.  The proof text is the separate project's, byte-for-byte; only
the imports and the `namespace KappaInd` scaffolding are replaced.  That project's
`Defs.lean` is NOT ported: `Unit2BKappaDefEqR10.lean` proves, by
`rfl` in the kernel, that every one of its definitions is definitionally equal to the
project's, so the proofs elaborate against the project's `Unit2B.FormalR1.*` and
`Unit2B.FormalR1.Kappa.*` definitions directly.

No project LEMMA is used anywhere in this file.  Name resolution is innermost-namespace
first, so every bare lemma name below resolves to a declaration of THIS namespace, and a
bare name that did not would show up as `sorryAx` in the axiom audit.

The statements in `Unit2BKappaStatementR1.lean` are proved here under
`Unit2B.FormalR1.Kappa.ProofsR10.*`; `TypeIdCheckKappaR10.lean` checks, at the kernel,
that each has exactly the type of the corresponding statement.
-/

open MeasureTheory ProbabilityTheory Set

noncomputable section

namespace Unit2B.FormalR1.Kappa.ProofsR10

section KappaInd_Step1
-- ported verbatim from KappaInd/Step1.lean, sha256 8e873e9530ef4b26a446e3a1bfbc04095f6beb17e33635dcae0b49490845bff4

/-
K-0, K-1, and the elementary positivity the later steps need.

Every lemma here is proved from the definitions, sorry-free.

Membership in `Box` is a conjunction of six inequalities, so it is reached with
`hθ.1`, `hθ.2.1`, etc. (not `.left`/`.right`, which do not apply to `And` in
recent Mathlib).
-/

open MeasureTheory ProbabilityTheory Set
open scoped Topology



/-- K-0: nu is the residual degrees of freedom, n - 1. -/
theorem nu_eq : nu = (nObs : ℝ) - 1 := by
  norm_num [nu, nObs]

/-- On the box, lambda is positive.

`Box` is a six-way conjunction, so the components are taken with
`hθ.1`, `hθ.2.1`, ...  -/
theorem lam_pos {θ : Param} (hθ : θ ∈ Box) : 0 < θ.1 := by
  have hbox : θ ∈ Box := hθ
  have hlo : (1 / 25 : ℝ) ≤ θ.1 := (show θ ∈ Box from hθ).1
  have hq : (0 : ℝ) < 1 / 25 := by norm_num
  linarith

/-- On the box, aF > 0, so every division by aF is legal.

`aF θ = (θ.2.2 - θ.2.1)^2 + 1 + θ.1 ≥ 0 + 1 + 1/25 > 0`. -/
theorem aF_pos {θ : Param} (hθ : θ ∈ Box) : 0 < aF θ := by
  have hsq : 0 ≤ (θ.2.2 - θ.2.1) ^ 2 := sq_nonneg _
  have hlam : (0 : ℝ) ≤ θ.1 := le_of_lt (lam_pos hθ)
  simp only [aF]
  nlinarith [hsq, hlam]

/-- K-1: the Gram matrix of the model is exactly Gmat. -/
theorem gram_eq {θ : Param} (hθ : θ ∈ Box) :
    Mmat θ * (Mmat θ).transpose = Gmat θ := by
  have hM : Mmat θ = !![θ.2.1, 1, 0; θ.2.2, 0, Real.sqrt θ.1] := rfl
  have hG : Gmat θ = !![g00 θ, g01 θ; g01 θ, g11 θ] := rfl
  rw [hM, hG]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Mmat, Gmat, g00, g11, g01, Matrix.mul_apply, Matrix.transpose_apply,
      Fin.sum_univ_succ, Fin.sum_univ_two, Fin.cases_zero, Fin.cases_succ] <;>
    try ring
  -- the (2,2) entry needs √λ ^ 2 = λ, which needs λ ≥ 0 from the box
  all_goals nlinarith [Real.sq_sqrt (le_of_lt (lam_pos hθ))]

end KappaInd_Step1

section KappaInd_Engine
-- ported verbatim from KappaInd/Engine.lean, sha256 5f10ea65d668db61924232681220ea91d210965f4c5d81f14aae51276105f517

/-
The Gaussian linear-functional engine.

Everything here is for an ARBITRARY finite index type `ι` and the product law
`stdPi ι = Measure.pi (fun _ : ι => gaussianReal 0 1)`; `panelLaw` is
`stdPi PanelIdx` by `rfl`.  All statements are on plain functions `ι → ℝ`
(no `EuclideanSpace` / `WithLp`), per the §5 warning of the statement.

Chain:
* coordinates are iid N(0,1)            (`iIndepFun_pi`, `measurePreserving_eval`)
* ⇒ the identity is jointly Gaussian    (`iIndepFun.hasGaussianLaw`)
* ⇒ any finite family of linear forms `lin a x = ∑ i, a i * x i` is jointly Gaussian
* their means are 0 and `cov[lin a, lin b] = ∑ i, a i * b i`
* ⇒ (Mathlib's `HasGaussianLaw.iIndepFun_of_covariance_eq_zero`) an orthonormal
  family of linear forms has law `stdPi κ`, and one unit form has law N(0,1).
-/

open MeasureTheory ProbabilityTheory Set



/-- The iid standard normal law on `ι → ℝ`. -/
abbrev stdPi (ι : Type*) [Fintype ι] : Measure (ι → ℝ) :=
  Measure.pi (fun _ : ι => gaussianReal 0 1)

/-- A linear form, as an explicit finite sum. -/
def lin {ι : Type*} [Fintype ι] (a : ι → ℝ) (x : ι → ℝ) : ℝ := ∑ i, a i * x i

variable {ι : Type*} [Fintype ι]

theorem lin_measurable (a : ι → ℝ) : Measurable (lin a) := by
  unfold lin; fun_prop

theorem stdPi_map_eval (i : ι) : (stdPi ι).map (fun x => x i) = gaussianReal 0 1 :=
  (measurePreserving_eval (fun _ : ι => gaussianReal 0 1) i).map_eq

theorem stdPi_iIndep : iIndepFun (fun i (x : ι → ℝ) => x i) (stdPi ι) :=
  iIndepFun_pi (X := fun _ => (id : ℝ → ℝ)) (fun _ => aemeasurable_id)

theorem stdPi_coord_gaussian (i : ι) : HasGaussianLaw (fun x : ι → ℝ => x i) (stdPi ι) := by
  have : IsGaussian ((stdPi ι).map (fun x => x i)) := by
    rw [stdPi_map_eval]; infer_instance
  exact IsGaussian.hasGaussianLaw (measurable_pi_apply i).aemeasurable

theorem stdPi_hasGaussianLaw : HasGaussianLaw (fun x : ι → ℝ => x) (stdPi ι) :=
  iIndepFun.hasGaussianLaw (X := fun i (x : ι → ℝ) => x i) stdPi_coord_gaussian stdPi_iIndep

/-- The continuous linear map `x ↦ (lin (A j) x)_j`. -/
def linCLM {κ : Type*} [Fintype κ] (A : κ → ι → ℝ) : (ι → ℝ) →L[ℝ] (κ → ℝ) :=
  LinearMap.toContinuousLinearMap (Matrix.mulVecLin (Matrix.of A))

theorem linCLM_apply {κ : Type*} [Fintype κ] (A : κ → ι → ℝ) (x : ι → ℝ) :
    linCLM A x = fun j => lin (A j) x := by
  funext j
  simp [linCLM, lin, Matrix.mulVec, dotProduct]

/-- A finite family of linear forms is jointly Gaussian. -/
theorem lin_family_gaussian {κ : Type*} [Fintype κ] (A : κ → ι → ℝ) :
    HasGaussianLaw (fun x : ι → ℝ => fun j => lin (A j) x) (stdPi ι) := by
  have h := (stdPi_hasGaussianLaw (ι := ι)).map_fun (linCLM A)
  simpa only [linCLM_apply] using h

/-- Two finite families of linear forms are jointly Gaussian (as a pair). -/
theorem lin_pair_gaussian {κ₁ κ₂ : Type*} [Fintype κ₁] [Fintype κ₂]
    (A : κ₁ → ι → ℝ) (B : κ₂ → ι → ℝ) :
    HasGaussianLaw (fun x : ι → ℝ => (fun j => lin (A j) x, fun j => lin (B j) x))
      (stdPi ι) := by
  have h := (stdPi_hasGaussianLaw (ι := ι)).map_fun ((linCLM A).prod (linCLM B))
  simpa only [ContinuousLinearMap.prod_apply, linCLM_apply] using h

/-- A single linear form is Gaussian. -/
theorem lin_gaussian (a : ι → ℝ) : HasGaussianLaw (lin a) (stdPi ι) := by
  have h := (lin_family_gaussian (ι := ι) (fun _ : Unit => a)).eval ()
  exact h

theorem coord_memLp (i : ι) : MemLp (fun x : ι → ℝ => x i) 2 (stdPi ι) :=
  (stdPi_coord_gaussian i).memLp_two

theorem integral_coord (i : ι) : ∫ x, x i ∂(stdPi ι) = 0 := by
  have h := integral_map (μ := stdPi ι) (measurable_pi_apply i).aemeasurable
    (f := fun y : ℝ => y) aestronglyMeasurable_id
  rw [stdPi_map_eval] at h
  rw [← h, integral_id_gaussianReal]

theorem integral_lin (a : ι → ℝ) : ∫ x, lin a x ∂(stdPi ι) = 0 := by
  unfold lin
  rw [integral_finsetSum]
  · refine Finset.sum_eq_zero fun i _ => ?_
    rw [integral_const_mul, integral_coord, mul_zero]
  · intro i _
    exact ((coord_memLp i).integrable one_le_two).const_mul (a i)

theorem cov_coord [DecidableEq ι] (i j : ι) :
    cov[fun x : ι → ℝ => x i, fun x => x j; stdPi ι] = if i = j then 1 else 0 := by
  split_ifs with h
  · subst h
    rw [covariance_self (measurable_pi_apply i).aemeasurable]
    have hv := variance_map (μ := stdPi ι) (X := id) aemeasurable_id
      (measurable_pi_apply i).aemeasurable
    rw [stdPi_map_eval, variance_id_gaussianReal] at hv
    have : (id ∘ fun x : ι → ℝ => x i) = fun x => x i := rfl
    rw [this] at hv
    rw [← hv]
    simp
  · exact (stdPi_iIndep.indepFun h).covariance_eq_zero (coord_memLp i) (coord_memLp j)

/-- The covariance of two linear forms is the dot product of their coefficients. -/
theorem cov_lin (a b : ι → ℝ) : cov[lin a, lin b; stdPi ι] = ∑ i, a i * b i := by
  classical
  have hX : ∀ i, MemLp (fun x : ι → ℝ => a i * x i) 2 (stdPi ι) :=
    fun i => (coord_memLp i).const_mul (a i)
  have hY : ∀ i, MemLp (fun x : ι → ℝ => b i * x i) 2 (stdPi ι) :=
    fun i => (coord_memLp i).const_mul (b i)
  have h := covariance_fun_sum_fun_sum (μ := stdPi ι) hX hY
  have hl : ∀ c : ι → ℝ, lin c = fun x => ∑ i, c i * x i := fun c => rfl
  rw [hl a, hl b, h]
  simp_rw [covariance_const_mul_left, covariance_const_mul_right, cov_coord]
  simp [mul_ite, Finset.sum_ite_eq]

theorem var_lin (a : ι → ℝ) : Var[lin a; stdPi ι] = ∑ i, a i ^ 2 := by
  rw [← covariance_self (lin_measurable a).aemeasurable, cov_lin]
  simp [sq]

/-- A unit linear form is standard normal. -/
theorem lin_map_eq (a : ι → ℝ) (h : ∑ i, a i ^ 2 = 1) :
    (stdPi ι).map (lin a) = gaussianReal 0 1 := by
  rw [(lin_gaussian a).map_eq_gaussianReal, integral_lin, var_lin, h]
  simp

/-- An orthonormal family of linear forms is iid standard normal. -/
theorem lin_family_map_eq {κ : Type*} [Fintype κ] [DecidableEq κ] (A : κ → ι → ℝ)
    (hA : ∀ j j', ∑ i, A j i * A j' i = if j = j' then 1 else 0) :
    (stdPi ι).map (fun x j => lin (A j) x) = stdPi κ := by
  have hind : iIndepFun (fun j => lin (A j)) (stdPi ι) := by
    refine (lin_family_gaussian A).iIndepFun_of_covariance_eq_zero fun j j' hjj' => ?_
    rw [cov_lin, hA, if_neg hjj']
  rw [(iIndepFun_iff_map_fun_eq_pi_map (fun j => (lin_measurable (A j)).aemeasurable)).1 hind]
  congr 1
  funext j
  refine lin_map_eq (A j) ?_
  have := hA j j
  simp only [if_pos rfl] at this
  simpa [sq] using this

end KappaInd_Engine

section KappaInd_Rot36
-- ported verbatim from KappaInd/Rot36.lean, sha256 0183229ba74971e1bd8ad641d647445325394a9572e448f75bdfcae0158ed0a7

/-
The time rotation: an orthogonal 36×36 matrix whose first row is constant 1/6.

Existence is from Mathlib (`Orthonormal.exists_orthonormalBasis_extension_of_card_eq`,
extending the unit vector (1/6)·𝟙 to an orthonormal basis of EuclideanSpace ℝ (Fin 36)).
The basis is immediately read off into a PLAIN matrix `O : Fin 36 → Fin 36 → ℝ`, and
everything downstream uses only the two plain-sum facts
  (row0) O 0 t = 1/6,   (rows) ∑ t, O s t * O s' t = [s = s'].
No `EuclideanSpace`/`WithLp` term escapes `exists_rot36`.

Consequences (all pathwise, plain sums):
* `rot_cols`   : ∑ s, O s t * O s t' = [t = t']      (square matrix, OOᵀ = 1 ⇒ OᵀO = 1)
* `rot_parseval`: ∑ s, (∑ t, O s t * x t)^2 = ∑ t, x t ^ 2
* `rot_css`    : ∑ t, (x t - x̄)^2 = ∑ s : Fin 35, (∑ t, O s.succ t * x t)^2   (Cochran, pathwise)
-/

open MeasureTheory ProbabilityTheory Set



/-- A plain orthogonal 36×36 matrix with first row 1/6. -/
def IsRot36 (O : Fin 36 → Fin 36 → ℝ) : Prop :=
  (∀ t, O 0 t = 1 / 6) ∧ ∀ s s', ∑ t, O s t * O s' t = if s = s' then 1 else 0

theorem exists_rot36 : ∃ O : Fin 36 → Fin 36 → ℝ, IsRot36 O := by
  let u : EuclideanSpace ℝ (Fin 36) := WithLp.toLp 2 (fun _ => (1 / 6 : ℝ))
  have hu : ‖u‖ = 1 := by
    rw [EuclideanSpace.norm_eq]
    simp only [u, Real.norm_eq_abs, sq_abs, Finset.sum_const,
      Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    rw [show ((36 : ℕ) : ℝ) * (1 / 6) ^ 2 = 1 by norm_num, Real.sqrt_one]
  have hv : Orthonormal ℝ (({0} : Set (Fin 36)).restrict (fun _ => u)) := by
    rw [orthonormal_iff_ite]
    rintro ⟨i, hi⟩ ⟨j, hj⟩
    simp only [mem_singleton_iff] at hi hj
    subst hi; subst hj
    simp only [if_true, real_inner_self_eq_norm_sq]
    show ‖u‖ ^ 2 = 1
    rw [hu, one_pow]
  obtain ⟨b, hb⟩ := hv.exists_orthonormalBasis_extension_of_card_eq (by simp)
  refine ⟨fun s t => b s t, ?_, ?_⟩
  · intro t
    show b 0 t = 1 / 6
    rw [hb 0 (mem_singleton 0)]
  · intro s s'
    have h := orthonormal_iff_ite.mp b.orthonormal s s'
    rw [PiLp.inner_apply] at h
    rw [← h]
    refine Finset.sum_congr rfl fun t _ => ?_
    simp only [RCLike.inner_apply, conj_trivial]
    ring

variable {O : Fin 36 → Fin 36 → ℝ}

theorem rot_cols (hO : IsRot36 O) (t t' : Fin 36) :
    ∑ s, O s t * O s t' = if t = t' then 1 else 0 := by
  have hA : Matrix.of O * (Matrix.of O).transpose = 1 := by
    ext s s'
    rw [Matrix.mul_apply, Matrix.one_apply]
    simpa only [Matrix.of_apply, Matrix.transpose_apply] using hO.2 s s'
  have hB := mul_eq_one_comm.mp hA
  have := congrFun (congrFun hB t) t'
  rw [Matrix.mul_apply, Matrix.one_apply] at this
  simpa only [Matrix.of_apply, Matrix.transpose_apply] using this

theorem rot_parseval (hO : IsRot36 O) (x : Fin 36 → ℝ) :
    ∑ s, (∑ t, O s t * x t) ^ 2 = ∑ t, x t ^ 2 := by
  calc ∑ s, (∑ t, O s t * x t) ^ 2
      = ∑ s, ∑ t, ∑ t', (O s t * x t) * (O s t' * x t') := by
        simp_rw [sq, Finset.sum_mul_sum]
    _ = ∑ t, ∑ t', ∑ s, (O s t * x t) * (O s t' * x t') := by
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun t _ => Finset.sum_comm
    _ = ∑ t, ∑ t', (x t * x t') * (∑ s, O s t * O s t') := by
        refine Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun t' _ => ?_
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun s _ => by ring
    _ = ∑ t, x t ^ 2 := by
        simp_rw [rot_cols hO, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ,
          if_true, sq]

/-- Pathwise Cochran: the centred sum of squares is the sum of the last 35 rotated squares. -/
theorem rot_css (hO : IsRot36 O) (x : Fin 36 → ℝ) :
    ∑ t, (x t - (∑ t', x t') / 36) ^ 2 = ∑ s : Fin 35, (∑ t, O s.succ t * x t) ^ 2 := by
  have hp := rot_parseval hO x
  rw [Fin.sum_univ_succ] at hp
  have h0 : ∑ t, O 0 t * x t = (∑ t, x t) / 6 := by
    simp_rw [hO.1]
    rw [← Finset.mul_sum]
    ring
  rw [h0] at hp
  have hexp : ∑ t, (x t - (∑ t', x t') / 36) ^ 2
      = ∑ t, x t ^ 2 - (∑ t, x t) ^ 2 / 36 := by
    simp_rw [sub_sq, Finset.sum_add_distrib, Finset.sum_sub_distrib]
    rw [← Finset.sum_mul, ← Finset.mul_sum, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]
    push_cast
    ring
  rw [hexp]
  linarith

end KappaInd_Rot36

section KappaInd_Step2
-- ported verbatim from KappaInd/Step2.lean, sha256 7affddcbf95b59616f63ddcd7503ef5eac9e4c9671caf2abf25af5f84a50b8a0

/-
K-5: the numerator's law.  Nstd is standard normal for every m.

The whole content is that m cancels.  Writing zbar z k for the time-mean of panel
row k, the numerator is

    sMean (ret1 m θ z) - sMean (ret0 m θ z)
      = (b1 - b0) * zbar z 0 + sqrt(λ) * zbar z 2 - zbar z 1

with NO m term, because ret0 and ret1 share one m.  Coefficient vector
(b1 - b0, -1, sqrt λ) is u^T M for u = e_1 - e_0, and its squared norm is aF.

Index note (caught by Lean, and worth keeping): √λ multiplies row 2, the
TREATED series' idiosyncratic shock, and the -1 multiplies row 1, the control's,
because ret1 loads z(2,·) and ret0 loads z(1,·).

Symbolic check of every identity here: math_check.py item 2.
-/

open MeasureTheory ProbabilityTheory Set
open scoped Topology



/-- The time-mean of panel row k. -/
def zbar (z : Panel) (k : Fin 3) : ℝ := sMean (fun t => z (k, t))

/-- sMean of a sum. -/
theorem sMean_add (x y : Fin nObs → ℝ) :
    sMean (fun t => x t + y t) = sMean x + sMean y := by
  unfold sMean
  rw [Finset.sum_add_distrib]
  ring

/-- sMean of a scaled function.

`Finset.mul_sum` wants the scalar outside the sum, so `sum_div` is used to
factor the denominator out first. -/
theorem sMean_mul (c : ℝ) (x : Fin nObs → ℝ) :
    sMean (fun t => c * x t) = c * sMean x := by
  unfold sMean
  rw [← Finset.mul_sum]
  ring

/-- sMean of a difference. -/
theorem sMean_sub (x y : Fin nObs → ℝ) :
    sMean (fun t => x t - y t) = sMean x - sMean y := by
  unfold sMean
  rw [Finset.sum_sub_distrib]
  ring

/-- K-5 step 1: m cancels from the numerator exactly. -/
theorem numerator_no_m (m : ℝ) (θ : Param) (z : Panel) :
    sMean (ret1 m θ z) - sMean (ret0 m θ z)
      = (θ.2.2 - θ.2.1) * zbar z 0 + Real.sqrt θ.1 * zbar z 2 - zbar z 1 := by
  have hstep : sMean (fun t => ret1 m θ z t) - sMean (fun t => ret0 m θ z t)
      = sMean (fun t => ret1 m θ z t - ret0 m θ z t) := by
    unfold sMean
    rw [Finset.sum_sub_distrib]
    ring
  rw [hstep]
  have hinner : sMean (fun t => ret1 m θ z t - ret0 m θ z t)
      = sMean (fun t => (θ.2.2 - θ.2.1) * z (0, t) + Real.sqrt θ.1 * z (2, t) - z (1, t)) := by
    have : (∑ t, (fun t => ret1 m θ z t - ret0 m θ z t) t)
        = ∑ t, (fun t => (θ.2.2 - θ.2.1) * z (0, t) + Real.sqrt θ.1 * z (2, t) - z (1, t)) t := by
      apply Finset.sum_congr rfl
      intro t _
      simp only [ret0, ret1]
      ring
    unfold sMean
    rw [this]
  rw [hinner]
  rw [sMean_sub, sMean_add, sMean_mul, sMean_mul]
  unfold zbar
  rfl

/-- Nstd is the linear form on the (scaled) row-means, over sqrt(aF). -/
theorem Nstd_eq_linear (m : ℝ) (θ : Param) (z : Panel) :
    Nstd m θ z
      = ((θ.2.2 - θ.2.1) * (Real.sqrt (nObs : ℝ) * zbar z 0)
         - (Real.sqrt (nObs : ℝ) * zbar z 1)
         + Real.sqrt θ.1 * (Real.sqrt (nObs : ℝ) * zbar z 2)) / Real.sqrt (aF θ) := by
  unfold Nstd
  rw [numerator_no_m]
  have h6 : (nObs : ℝ) = 36 := by norm_num [nObs]
  rw [h6]
  have h36 : (36 : ℕ) = (36 : ℤ) := by omega
  have hs : (0 : ℝ) ≤ (36 : ℝ) := by norm_num
  push_cast
  field_simp
  ring

end KappaInd_Step2

section KappaInd_Step4
-- ported verbatim from KappaInd/Step4.lean, sha256 1950d4bc2ab0de5c6aba9a5a5dafc568811c3064334a5232d42892dcf90c9968

/-
K-2: Sres is the pathwise Gram form.

Pathwise, so no measure theory.  `Sres m θ z = nu * (sVar₀ + sVar₁)`; since
`nu = n - 1 = 35` and `sVar` divides by `n - 1`, this is exactly the sum of the
two centred sums of squares.  And the centred control/treated series equal the
rows of the Gram form, because `ret0`/`ret1` differ from the corresponding Gram
row by a constant in t (the shared m plus the row means), which centring kills.

`Mmat θ` is a `Matrix (Fin 2) (Fin 3) ℝ`, so rows are read with
`Matrix.mulVec (Mmat θ) v i` — the §5 warning applies, `*ᵥ` is scoped.

TECHNIQUE NOTES (each cost a build; recorded so they are not rediscovered):
- `nObs` is a `def`, so `Fin nObs` is a Fintype over an opaque Nat and
  `simp [nObs]` CANNOT reduce `Finset.univ.card` on it.  Use `show` with the
  literal `Fin 36`.
- `sMean` divides AFTER summing, so `Finset.mul_sum` must be used in the
  reverse direction (←) after rewriting the denominator to 36, and the
  remaining scalar-distribution step is closed by `field_simp` alone.
- `field_simp` closes the goal, so no trailing `ring` (else: "No goals to be
  solved").
- To unfold `Matrix.mulVec` on a literal matrix, `Matrix.vecHead` and
  `Matrix.vecTail` must be added to the simp set; there are no
  `vecHead_cons`/`vecTail_cons` lemmas at this rev.
-/

open MeasureTheory ProbabilityTheory Set
open scoped Topology



/-- The number of observations, as a real. -/
theorem nObs_real : (nObs : ℝ) = 36 := by norm_num [nObs]

/-- nObs - 1 is the residual df, as a real. -/
theorem nObs_minus_one : ((nObs : ℝ) - 1) = 35 := by norm_num [nObs]

/-- Sum of a constant over all 36 observations. -/
theorem sum_const_nObs (c : ℝ) : (∑ t : Fin nObs, c) = 36 * c := by
  show (∑ t : Fin 36, c) = 36 * c
  simp [Finset.sum_const]

/-- The mean of the control series. -/
theorem sMean_ret0 (m : ℝ) (θ : Param) (z : Panel) :
    sMean (ret0 m θ z)
      = m + θ.2.1 * sMean (fun s => z (0, s)) + sMean (fun s => z (1, s)) := by
  unfold sMean
  simp only [ret0]
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, sum_const_nObs,
    nObs_real, ← Finset.mul_sum]
  field_simp

/-- The mean of the treated series. -/
theorem sMean_ret1 (m : ℝ) (θ : Param) (z : Panel) :
    sMean (ret1 m θ z)
      = m + θ.2.2 * sMean (fun s => z (0, s)) + Real.sqrt θ.1 * sMean (fun s => z (2, s)) := by
  unfold sMean
  simp only [ret1]
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, sum_const_nObs,
    nObs_real, ← Finset.mul_sum, ← Finset.mul_sum]
  field_simp

/-- Row 0 of the Gram form: `θ.2.1` on the common factor, `1` on the control shock. -/
theorem mulVec_row0 (θ : Param) (v : Fin 3 → ℝ) :
    Matrix.mulVec (Mmat θ) v 0 = θ.2.1 * v 0 + v 1 := by
  simp [Mmat, Matrix.mulVec, Matrix.vecHead, Matrix.vecTail, Matrix.cons_val_zero,
    Matrix.head_cons, Fin.sum_univ_succ, Fin.sum_univ_two]

/-- Row 1 of the Gram form: `θ.2.2` on the common factor, `√λ` on the treated shock. -/
theorem mulVec_row1 (θ : Param) (v : Fin 3 → ℝ) :
    Matrix.mulVec (Mmat θ) v 1 = θ.2.2 * v 0 + Real.sqrt θ.1 * v 2 := by
  simp [Mmat, Matrix.mulVec, Matrix.vecHead, Matrix.vecTail, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons, Fin.sum_univ_succ, Fin.sum_univ_two]

/-- The centred control series is row 0 of the Gram form. -/
theorem ret0_sub_mean_eq (m : ℝ) (θ : Param) (z : Panel) :
    (fun t => ret0 m θ z t - sMean (ret0 m θ z))
      = (fun t => Matrix.mulVec (Mmat θ) (zc z t) 0) := by
  funext t
  have h := sMean_ret0 m θ z
  simp only [ret0]
  rw [h, mulVec_row0]
  simp only [zc, Pi.zero_apply]
  ring

/-- The centred treated series is row 1 of the Gram form. -/
theorem ret1_sub_mean_eq (m : ℝ) (θ : Param) (z : Panel) :
    (fun t => ret1 m θ z t - sMean (ret1 m θ z))
      = (fun t => Matrix.mulVec (Mmat θ) (zc z t) 1) := by
  funext t
  have h := sMean_ret1 m θ z
  simp only [ret1]
  rw [h, mulVec_row1]
  simp only [zc, Pi.zero_apply]
  ring

/-- K-2: Sres is the pathwise Gram form on centred coordinates. -/
theorem Sres_eq_gram_form (m : ℝ) (θ : Param) (z : Panel) :
    Sres m θ z = ∑ t, ∑ i, (Matrix.mulVec (Mmat θ) (zc z t)) i ^ 2 := by
  -- pointwise forms, so `simp_rw` fires inside the sum
  have h0 : ∀ t, ret0 m θ z t - sMean (ret0 m θ z) = Matrix.mulVec (Mmat θ) (zc z t) 0 :=
    fun t => congrFun (ret0_sub_mean_eq m θ z) t
  have h1 : ∀ t, ret1 m θ z t - sMean (ret1 m θ z) = Matrix.mulVec (Mmat θ) (zc z t) 1 :=
    fun t => congrFun (ret1_sub_mean_eq m θ z) t
  unfold Sres
  rw [nu_eq]
  simp only [sVar]
  rw [nObs_minus_one]
  -- LHS is 35 * ((Σ t, A t^2)/35 + (Σ t, B t^2)/35); cancel and merge the sums
  have hmerge : 35 * ((∑ t, (ret0 m θ z t - sMean (ret0 m θ z)) ^ 2) / 35
        + (∑ t, (ret1 m θ z t - sMean (ret1 m θ z)) ^ 2) / 35)
      = ∑ t, ((ret0 m θ z t - sMean (ret0 m θ z)) ^ 2
        + (ret1 m θ z t - sMean (ret1 m θ z)) ^ 2) := by
    field_simp
    rw [Finset.sum_add_distrib]
  rw [hmerge]
  simp only [Fin.sum_univ_two]
  simp_rw [h0, h1]

end KappaInd_Step4

section KappaInd_K5
-- ported verbatim from KappaInd/K5.lean, sha256 b549f07efd7c5cea4fb3d4e2b4572e92cd5061f97349cc2e7e6b2bd25999414d

/-
K-5, distributional half: `panelLaw.map (Nstd m θ) = gaussianReal 0 1`.

`Nstd m θ` is, pathwise and for EVERY m (m cancels: `numerator_no_m`, Step2),
the linear form `lin (nCoef θ)` with coefficient `dvec θ k / (6 √aF)` on panel
entry `(k, t)`, where `dvec θ = (b₁ - b₀, -1, √λ)`.  Its coefficient vector has
squared norm `36 · |dvec θ|² / (36 aF) = 1` exactly when `|dvec θ|² = aF θ`,
i.e. when `(√λ)² = λ`, which needs `0 ≤ λ` (from the box).  Then the engine's
`lin_map_eq` gives the law.
-/

open MeasureTheory ProbabilityTheory Set



theorem panelLaw_eq : panelLaw = stdPi PanelIdx := rfl

/-- The numerator's coefficient on each of the three shocks. -/
def dvec (θ : Param) (k : Fin 3) : ℝ :=
  if k = 0 then θ.2.2 - θ.2.1 else if k = 1 then -1 else Real.sqrt θ.1

/-- The coefficient of `Nstd` on panel entry `(k, t)`. -/
def nCoef (θ : Param) (p : PanelIdx) : ℝ := dvec θ p.1 / (6 * Real.sqrt (aF θ))

theorem sqrt_nObs : Real.sqrt (nObs : ℝ) = 6 := by
  rw [show (nObs : ℝ) = 6 ^ 2 by norm_num [nObs]]
  exact Real.sqrt_sq (by norm_num)

/-- Pathwise: `Nstd m θ` is the linear form `lin (nCoef θ)`, for every `m`. -/
theorem Nstd_eq_lin (m : ℝ) (θ : Param) : Nstd m θ = lin (nCoef θ) := by
  funext z
  rw [Nstd, numerator_no_m, sqrt_nObs]
  simp only [lin, nCoef, Fintype.sum_prod_type, Fin.sum_univ_three, dvec, zbar, sMean]
  simp only [show (1 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 0 by decide,
    show (2 : Fin 3) ≠ 1 by decide, if_true, if_false]
  rw [← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
  rw [show (nObs : ℝ) = 36 by norm_num [nObs]]
  ring

/-- The coefficient vector of `Nstd` has unit norm on the box. -/
theorem nCoef_norm {θ : Param} (hθ : θ ∈ Box) : ∑ p, nCoef θ p ^ 2 = 1 := by
  have ha := aF_pos hθ
  have hl := (lam_pos hθ).le
  simp only [nCoef, Fintype.sum_prod_type, Fin.sum_univ_three, dvec]
  simp only [show (1 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 0 by decide,
    show (2 : Fin 3) ≠ 1 by decide, if_true, if_false, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, nsmul_eq_mul]
  rw [div_pow, div_pow, div_pow, mul_pow, Real.sq_sqrt ha.le, Real.sq_sqrt hl]
  rw [show ((nObs : ℕ) : ℝ) = 36 by norm_num [nObs]]
  field_simp
  simp only [aF]
  ring

/-- K-5: the numerator's law.  Standard normal, for every `m`. -/
theorem kappa_numerator_law (m : ℝ) {θ : Param} (hθ : θ ∈ Box) :
    panelLaw.map (Nstd m θ) = gaussianReal 0 1 := by
  rw [Nstd_eq_lin, panelLaw_eq]
  exact lin_map_eq (nCoef θ) (nCoef_norm hθ)

end KappaInd_K5

section KappaInd_K4
-- ported verbatim from KappaInd/K4.lean, sha256 3b99651821ca6cc30712a70fc77f70afc5a5559fd4225dee795ac68ef657d2e7

/-
K-4: the rejection event, pathwise.

Write D = sMean ret1 - sMean ret0, S = Sres = 35 (s₀² + s₁²).  Then
  Tstat = D / √(S / (35·36)) = D / (√(S/35) / 6),
  Nstd  = 6 D / √aF,
  √(S / (nu·aF)) = √(S/35) / √aF,
so both sides are `c · √(S/35) < 6 D` after clearing the positive denominators
`√(S/35)/6` and `√aF`.  (`0 < c` is not needed; `0 < S` and `0 < aF` are.)
-/

open MeasureTheory ProbabilityTheory Set



/-- K-4: the event, pathwise (standardise by D0 = aF). -/
theorem kappa_event {m c : ℝ} {θ : Param} (hθ : θ ∈ Box) (hc : 0 < c) {z : Panel}
    (hS : 0 < Sres m θ z) :
    c < Tstat m θ z ↔ c * Real.sqrt (Sres m θ z / (nu * aF θ)) < Nstd m θ z := by
  have ha := aF_pos hθ
  set D := sMean (ret1 m θ z) - sMean (ret0 m θ z) with hD
  set S := Sres m θ z with hSdef
  have hden : sVar (ret1 m θ z) / (nObs : ℝ) + sVar (ret0 m θ z) / (nObs : ℝ)
      = (S / 35) / 36 := by
    rw [hSdef, Sres, show (nObs : ℝ) = 36 by norm_num [nObs], nu]
    ring
  have hq : 0 < Real.sqrt (S / 35) := Real.sqrt_pos.mpr (by linarith)
  have hsa : 0 < Real.sqrt (aF θ) := Real.sqrt_pos.mpr ha
  have h36 : Real.sqrt 36 = 6 := by
    rw [show (36 : ℝ) = 6 ^ 2 by norm_num]; exact Real.sqrt_sq (by norm_num)
  have hT : Tstat m θ z = D / (Real.sqrt (S / 35) / 6) := by
    rw [Tstat, hden, Real.sqrt_div' _ (by norm_num : (0 : ℝ) ≤ 36), h36]
  have hR : Real.sqrt (S / (nu * aF θ)) = Real.sqrt (S / 35) / Real.sqrt (aF θ) := by
    rw [show S / (nu * aF θ) = (S / 35) / aF θ by rw [nu]; ring,
      Real.sqrt_div' _ ha.le]
  have hN : Nstd m θ z = 6 * D / Real.sqrt (aF θ) := by
    rw [Nstd, sqrt_nObs]
  rw [hT, hR, hN, lt_div_iff₀ (by positivity),
    show c * (Real.sqrt (S / 35) / Real.sqrt (aF θ)) = c * Real.sqrt (S / 35) / Real.sqrt (aF θ)
      by ring, div_lt_div_iff_of_pos_right hsa]
  constructor
  · intro h; nlinarith
  · intro h; nlinarith

end KappaInd_K4

section KappaInd_K6
-- ported verbatim from KappaInd/K6.lean, sha256 88ab8b2e09e5fbf8abdf5a0079d3da7b0e39f957178cbd7c4444dbdf7019f8de

/-
K-6: `IndepFun (Nstd m θ) (Sres m θ) panelLaw`.

NOT via Cov(Nstd, Sres) = 0 (that pair is not jointly Gaussian).  Instead:

* `Nstd m θ = lin (nCoef θ)`                         (K5.lean, every m)
* each centred residual `zc z t k = lin (rCoef (k,t)) z`, with
  `rCoef (k,t) (k',s) = [k' = k] (δ_{st} - 1/36)`
* `(Nstd, (zc_{k,t})_{k,t})` is a jointly Gaussian linear image of the panel
  (engine `lin_pair_gaussian`), and every cross-covariance is
  `∑_s dvec k/(6√aF) · (δ_{st} - 1/36) = 0`
* Mathlib `HasGaussianLaw.indepFun_of_covariance_eval` ⇒ Nstd ⟂ (zc_{k,t})
  (the 108-vector `zc` is a DEGENERATE Gaussian, rank 105; the lemma is
  characteristic-function based and needs no density)
* `Sres` is a measurable function of `zc` alone (K-2, `Sres_eq_gram_form`),
  so `IndepFun.comp` finishes.
-/

open MeasureTheory ProbabilityTheory Set



/-- Coefficients of the centred residual `zc z t k` on panel entry `p`. -/
def rCoef (q : PanelIdx) (p : PanelIdx) : ℝ :=
  if p.1 = q.1 then (if p.2 = q.2 then 1 else 0) - 1 / 36 else 0

theorem zc_eq_lin (z : Panel) (t : Fin nObs) (k : Fin 3) :
    zc z t k = lin (rCoef (k, t)) z := by
  rw [lin, Fintype.sum_prod_type,
    Finset.sum_eq_single k (fun b _ hb => by simp [rCoef, hb]) (by simp)]
  simp only [rCoef, sub_mul, ite_mul, one_mul, zero_mul, Finset.sum_sub_distrib,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  rw [← Finset.mul_sum, zc, sMean, show (nObs : ℝ) = 36 by norm_num [nObs]]
  ring

/-- Every cross-covariance between `Nstd` and a centred residual vanishes. -/
theorem nCoef_rCoef_orth (θ : Param) (q : PanelIdx) : ∑ p, nCoef θ p * rCoef q p = 0 := by
  obtain ⟨k, t⟩ := q
  rw [Fintype.sum_prod_type,
    Finset.sum_eq_single k (fun b _ hb => by simp [rCoef, hb]) (by simp)]
  simp only [rCoef, mul_sub, mul_ite, mul_one, mul_zero, Finset.sum_sub_distrib,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true, nCoef]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    show ((nObs : ℕ) : ℝ) = 36 by norm_num [nObs]]
  ring

/-- The Gram-form functional of K-2, on the residual vector. -/
def gramOf (θ : Param) (r : PanelIdx → ℝ) : ℝ :=
  ∑ t : Fin nObs, ∑ i, (Matrix.mulVec (Mmat θ) (fun k => r (k, t)) i) ^ 2

theorem gramOf_measurable (θ : Param) : Measurable (gramOf θ) := by
  unfold gramOf Matrix.mulVec dotProduct
  fun_prop

theorem Sres_eq_gramOf (m : ℝ) (θ : Param) :
    Sres m θ = fun z => gramOf θ (fun q => lin (rCoef q) z) := by
  funext z
  rw [Sres_eq_gram_form, gramOf]
  congr 1
  funext t
  congr 1
  funext i
  congr 3
  funext k
  exact zc_eq_lin z t k

/-- K-6: the numerator is independent of the residual sum of squares. -/
theorem kappa_indep (m : ℝ) {θ : Param} (hθ : θ ∈ Box) :
    IndepFun (Nstd m θ) (Sres m θ) panelLaw := by
  have hG := lin_pair_gaussian (ι := PanelIdx) (fun _ : Unit => nCoef θ) rCoef
  have hI : IndepFun (fun z (_ : Unit) => lin (nCoef θ) z) (fun z q => lin (rCoef q) z)
      (stdPi PanelIdx) := by
    refine HasGaussianLaw.indepFun_of_covariance_eval
      (X := fun (_ : Unit) => lin (nCoef θ)) (Y := fun q => lin (rCoef q)) hG ?_
    intro _ q
    rw [cov_lin, nCoef_rCoef_orth]
  have hφ : Measurable (fun f : Unit → ℝ => f ()) := measurable_pi_apply ()
  have hC := hI.comp hφ (gramOf_measurable θ)
  rw [Nstd_eq_lin, Sres_eq_gramOf, panelLaw_eq]
  exact hC

end KappaInd_K6

section KappaInd_ChiSq
-- ported verbatim from KappaInd/ChiSq.lean, sha256 fee11da8ed663cebfa7785eb6370e7500ef6c9e7a257f25ba3aac05963126bca

/-
The Gaussian → gamma bridge (no chi-squared distribution exists in Mathlib at
this rev, and there is no gamma convolution; both are needed nowhere below).

1. `ext_of_mgf_Ioo`: two probability laws on ℝ whose mgfs are finite and agree on
   an interval (-ε, ε) are equal.  Mathlib at this rev only has the version
   assuming equality of mgfs on ALL of ℝ (and its TODO says so); this is the same
   argument (identity theorem for the analytic `complexMGF` on the strip
   `{z | z.re ∈ (-ε, ε)}`, then evaluate on the imaginary axis, which is the
   characteristic function, then `Measure.ext_of_charFun`).
2. `integral_exp_sq_gaussian`: `∫ e^{u x²} dN(0,1) = (1 - 2u)^{-1/2}` for u < 1/2.
3. `integral_exp_gamma`: `∫ e^{u x} dΓ(a, r) = (r / (r - u))^a` for u < r.
4. `chi_mix_law`: for ANY real weights w₀ w₁ and X₁, X₂ iid Γ(35/2, 1/2),
     (stdPi (Fin 2 × Fin 35)).map (w₀ Σ_s x(0,s)² + w₁ Σ_s x(1,s)²)
       = P.map (w₀ X₁ + w₁ X₂),
   by 1 with ε = 1 / (2 (|w₀| + |w₁| + 1)): both mgfs equal
   ((1 - 2 t w₀)(1 - 2 t w₁))^{-35/2} there.
-/

open MeasureTheory ProbabilityTheory Set Filter
open scoped Topology Real



/-- Uniqueness from the mgf on a neighbourhood of 0. -/
theorem ext_of_mgf_Ioo {μ ν : Measure ℝ} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {ε : ℝ} (hε : 0 < ε)
    (hμ : ∀ t ∈ Ioo (-ε) ε, Integrable (fun x => Real.exp (t * x)) μ)
    (hν : ∀ t ∈ Ioo (-ε) ε, Integrable (fun x => Real.exp (t * x)) ν)
    (h : ∀ t ∈ Ioo (-ε) ε, mgf id μ t = mgf id ν t) : μ = ν := by
  set U : Set ℂ := {z | z.re ∈ Ioo (-ε) ε} with hU
  have hsubμ : Ioo (-ε) ε ⊆ interior (integrableExpSet id μ) :=
    interior_maximal (fun t ht => hμ t ht) isOpen_Ioo
  have hsubν : Ioo (-ε) ε ⊆ interior (integrableExpSet id ν) :=
    interior_maximal (fun t ht => hν t ht) isOpen_Ioo
  have hAμ : AnalyticOnNhd ℂ (complexMGF id μ) U :=
    analyticOnNhd_complexMGF.mono (fun z hz => hsubμ hz)
  have hAν : AnalyticOnNhd ℂ (complexMGF id ν) U :=
    analyticOnNhd_complexMGF.mono (fun z hz => hsubν hz)
  have hUc : IsPreconnected U :=
    ((convex_Ioo (-ε) ε).linear_preimage Complex.reLm).isPreconnected
  have h0 : ((0 : ℝ) : ℂ) ∈ U := by
    simp only [hU, mem_setOf_eq, Complex.ofReal_re, mem_Ioo]
    constructor <;> linarith
  have h_real : ∃ᶠ (x : ℝ) in 𝓝[≠] (0 : ℝ), complexMGF id μ x = complexMGF id ν x := by
    have hev : ∀ᶠ x : ℝ in 𝓝[≠] (0 : ℝ), x ∈ Ioo (-ε) ε :=
      nhdsWithin_le_nhds (Ioo_mem_nhds (by linarith) hε)
    refine (hev.mono fun x hx => ?_).frequently
    rw [complexMGF_ofReal, complexMGF_ofReal, h x hx]
  have h_freq : ∃ᶠ z in 𝓝[≠] ((0 : ℝ) : ℂ), complexMGF id μ z = complexMGF id ν z := by
    rw [frequently_iff_seq_forall] at h_real ⊢
    obtain ⟨xs, hx_tendsto, hx_eq⟩ := h_real
    refine ⟨fun n ↦ xs n, ?_, fun n ↦ ?_⟩
    · rw [tendsto_nhdsWithin_iff] at hx_tendsto ⊢
      constructor
      · rw [Filter.tendsto_ofReal_iff]
        exact hx_tendsto.1
      · simpa using hx_tendsto.2
    · simp [hx_eq]
  have hEq := hAμ.eqOn_of_preconnected_of_frequently_eq hAν hUc h0 h_freq
  apply Measure.ext_of_charFun
  funext t
  rw [← complexMGF_id_mul_I, ← complexMGF_id_mul_I]
  apply hEq
  simp only [hU, mem_setOf_eq, Complex.mul_re, Complex.ofReal_re, Complex.I_re, mul_zero,
    Complex.ofReal_im, Complex.I_im, mul_one, sub_self, mem_Ioo]
  constructor <;> linarith

/-- The mgf of a squared standard normal. -/
theorem integral_exp_sq_gaussian {u : ℝ} (hu : u < 1 / 2) :
    ∫ x, Real.exp (u * x ^ 2) ∂(gaussianReal 0 1) = (1 - 2 * u) ^ (-(1 / 2 : ℝ)) := by
  have h1 : 0 < 1 - 2 * u := by linarith
  rw [integral_gaussianReal_eq_integral_smul (by norm_num : (1 : NNReal) ≠ 0)]
  have hpt : ∀ x : ℝ, gaussianPDFReal 0 1 x • Real.exp (u * x ^ 2)
      = (Real.sqrt (2 * π))⁻¹ * Real.exp (-(1 / 2 - u) * x ^ 2) := by
    intro x
    simp only [gaussianPDFReal, smul_eq_mul, NNReal.coe_one, sub_zero, mul_one]
    rw [mul_assoc, ← Real.exp_add]
    congr 2
    ring
  simp_rw [hpt]
  rw [integral_const_mul, integral_gaussian]
  rw [show π / (1 / 2 - u) = (2 * π) / (1 - 2 * u) by
    rw [div_eq_div_iff (by linarith) (by linarith)]; ring]
  rw [Real.sqrt_div' _ h1.le, Real.rpow_neg h1.le, ← Real.sqrt_eq_rpow]
  have h2 : 0 < Real.sqrt (2 * π) := by positivity
  have h3 : 0 < Real.sqrt (1 - 2 * u) := Real.sqrt_pos.mpr h1
  field_simp

theorem integrable_exp_sq_gaussian {u : ℝ} (hu : u < 1 / 2) :
    Integrable (fun x => Real.exp (u * x ^ 2)) (gaussianReal 0 1) := by
  refine Integrable.of_integral_ne_zero ?_
  rw [integral_exp_sq_gaussian hu]
  exact (Real.rpow_pos_of_pos (by linarith) _).ne'

/-- The mgf of the gamma law. -/
theorem integral_exp_gamma {a r u : ℝ} (ha : 0 < a) (hr : 0 < r) (hu : u < r) :
    ∫ x, Real.exp (u * x) ∂(gammaMeasure a r) = (r / (r - u)) ^ a := by
  have hru : 0 < r - u := by linarith
  have hmeas : Measurable (gammaPDF a r) := by
    show Measurable (fun x => ENNReal.ofReal (gammaPDFReal a r x))
    exact (measurable_gammaPDFReal a r).ennreal_ofReal
  rw [gammaMeasure, integral_withDensity_eq_integral_toReal_smul hmeas
    (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
  have hpt : ∀ x : ℝ, (gammaPDF a r x).toReal • Real.exp (u * x)
      = Set.indicator (Ici 0)
          (fun x => r ^ a / Real.Gamma a * (x ^ (a - 1) * Real.exp (-((r - u) * x)))) x := by
    intro x
    rw [gammaPDF, ENNReal.toReal_ofReal (gammaPDFReal_nonneg ha hr x), gammaPDFReal,
      Set.indicator, smul_eq_mul]
    by_cases hx : 0 ≤ x
    · rw [if_pos hx, if_pos (show x ∈ Ici 0 from hx), mul_assoc, mul_assoc, ← Real.exp_add]
      congr 3
      ring
    · rw [if_neg hx, if_neg (show x ∉ Ici 0 from hx), zero_mul]
  simp_rw [hpt]
  rw [integral_indicator measurableSet_Ici, integral_Ici_eq_integral_Ioi, integral_const_mul,
    Real.integral_rpow_mul_exp_neg_mul_Ioi ha hru]
  have hG : 0 < Real.Gamma a := Real.Gamma_pos_of_pos ha
  rw [Real.div_rpow hr.le hru.le, one_div, Real.inv_rpow hru.le]
  field_simp

theorem integrable_exp_gamma {a r u : ℝ} (ha : 0 < a) (hr : 0 < r) (hu : u < r) :
    Integrable (fun x => Real.exp (u * x)) (gammaMeasure a r) := by
  refine Integrable.of_integral_ne_zero ?_
  rw [integral_exp_gamma ha hr hu]
  exact (Real.rpow_pos_of_pos (div_pos hr (by linarith)) _).ne'

/-- The chi-squared identity at the level of mgfs: (E e^{uZ²})³⁵ = E e^{uX}, X ~ Γ(35/2,1/2). -/
theorem mgf_chi35 {u : ℝ} (hu : u < 1 / 2) :
    (∫ x, Real.exp (u * x ^ 2) ∂(gaussianReal 0 1)) ^ 35
      = ∫ x, Real.exp (u * x) ∂(gammaMeasure (35 / 2) (1 / 2)) := by
  have h1 : 0 < 1 - 2 * u := by linarith
  rw [integral_exp_sq_gaussian hu, integral_exp_gamma (by norm_num) (by norm_num) hu,
    ← Real.rpow_natCast, ← Real.rpow_mul h1.le,
    show (1 / 2 : ℝ) / (1 / 2 - u) = (1 - 2 * u)⁻¹ by field_simp,
    Real.inv_rpow h1.le, ← Real.rpow_neg h1.le]
  norm_num

/-- The weighted two-block chi-squared law, transferred to any iid Γ(35/2,1/2) pair. -/
theorem chi_mix_law {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {X1 X2 : Ω → ℝ} (hX1m : Measurable X1) (hX2m : Measurable X2)
    (hX1 : P.map X1 = gammaMeasure (35 / 2) (1 / 2))
    (hX2 : P.map X2 = gammaMeasure (35 / 2) (1 / 2))
    (hInd : IndepFun X1 X2 P) (w0 w1 : ℝ) :
    (stdPi (Fin 2 × Fin 35)).map
        (fun x => w0 * ∑ s, x (0, s) ^ 2 + w1 * ∑ s, x (1, s) ^ 2)
      = P.map (fun ω => w0 * X1 ω + w1 * X2 ω) := by
  set F : (Fin 2 × Fin 35 → ℝ) → ℝ :=
    fun x => w0 * ∑ s, x (0, s) ^ 2 + w1 * ∑ s, x (1, s) ^ 2 with hF
  set Z : Ω → ℝ := fun ω => w0 * X1 ω + w1 * X2 ω with hZ
  have hFm : Measurable F := by rw [hF]; fun_prop
  have hZm : Measurable Z := by rw [hZ]; fun_prop
  -- weights by block
  let wt : Fin 2 → ℝ := fun j => if j = 0 then w0 else w1
  set ε : ℝ := 1 / (2 * (|w0| + |w1| + 1)) with hε
  have hden : 0 < |w0| + |w1| + 1 := by positivity
  have hεpos : 0 < ε := by positivity
  have hsmall : ∀ t ∈ Ioo (-ε) ε, t * w0 < 1 / 2 ∧ t * w1 < 1 / 2 := by
    intro t ht
    have htabs : |t| < ε := abs_lt.mpr ⟨ht.1, ht.2⟩
    have hkey : |t| * (|w0| + |w1| + 1) < 1 / 2 := by
      calc |t| * (|w0| + |w1| + 1) < ε * (|w0| + |w1| + 1) :=
            mul_lt_mul_of_pos_right htabs hden
        _ = 1 / 2 := by rw [hε]; field_simp
    have ha0 : |t * w0| < 1 / 2 := by
      rw [abs_mul]; nlinarith [abs_nonneg t, abs_nonneg w0, abs_nonneg w1]
    have ha1 : |t * w1| < 1 / 2 := by
      rw [abs_mul]; nlinarith [abs_nonneg t, abs_nonneg w0, abs_nonneg w1]
    exact ⟨lt_of_le_of_lt (le_abs_self _) ha0, lt_of_le_of_lt (le_abs_self _) ha1⟩
  have hwt : ∀ t ∈ Ioo (-ε) ε, ∀ j, t * wt j < 1 / 2 := by
    intro t ht j
    by_cases hj : j = 0
    · simp only [wt, if_pos hj]; exact (hsmall t ht).1
    · simp only [wt, if_neg hj]; exact (hsmall t ht).2
  -- the panel side as a product
  have hprod : ∀ t : ℝ, (fun x => Real.exp (t * F x))
      = fun x : Fin 2 × Fin 35 → ℝ => ∏ p, (fun p y => Real.exp (t * wt p.1 * y ^ 2)) p (x p) := by
    intro t
    funext x
    rw [← Real.exp_sum]
    congr 1
    rw [Fintype.sum_prod_type, Fin.sum_univ_two, hF]
    simp only [wt, if_pos rfl, show (1 : Fin 2) ≠ 0 by decide, if_false]
    rw [Finset.mul_sum, Finset.mul_sum, mul_add, Finset.mul_sum, Finset.mul_sum]
    congr 1 <;> exact Finset.sum_congr rfl fun s _ => by ring
  have hLint : ∀ t ∈ Ioo (-ε) ε,
      Integrable (fun x => Real.exp (t * x)) ((stdPi (Fin 2 × Fin 35)).map F) := by
    intro t ht
    have hi0 : ∀ p : Fin 2 × Fin 35,
        Integrable (fun y : ℝ => Real.exp (t * wt p.1 * y ^ 2)) (gaussianReal 0 1) :=
      fun p => integrable_exp_sq_gaussian (hwt t ht p.1)
    have hi : Integrable
        (fun x : Fin 2 × Fin 35 → ℝ => ∏ p, (fun p y => Real.exp (t * wt p.1 * y ^ 2)) p (x p))
        (stdPi (Fin 2 × Fin 35)) :=
      Integrable.fintype_prod (μ := fun _ => gaussianReal 0 1) hi0
    have hi' : Integrable (fun x => Real.exp (t * F x)) (stdPi (Fin 2 × Fin 35)) := by
      rw [hprod t]; exact hi
    have hg : AEStronglyMeasurable (fun x : ℝ => Real.exp (t * x))
        ((stdPi (Fin 2 × Fin 35)).map F) :=
      (Real.continuous_exp.comp (continuous_const.mul continuous_id)).aestronglyMeasurable
    exact (integrable_map_measure hg hFm.aemeasurable).2 hi'
  have hLmgf : ∀ t ∈ Ioo (-ε) ε, mgf id ((stdPi (Fin 2 × Fin 35)).map F) t
      = (∫ x, Real.exp ((t * w0) * x ^ 2) ∂(gaussianReal 0 1)) ^ 35
        * (∫ x, Real.exp ((t * w1) * x ^ 2) ∂(gaussianReal 0 1)) ^ 35 := by
    intro t _
    have hint := integral_fintype_prod_eq_prod (ι := Fin 2 × Fin 35) (E := fun _ => ℝ)
      (fun (p : Fin 2 × Fin 35) (y : ℝ) => Real.exp (t * wt p.1 * y ^ 2))
      (μ := fun _ => gaussianReal 0 1)
    rw [mgf_id_map hFm.aemeasurable, mgf, hprod t,
      show stdPi (Fin 2 × Fin 35) = Measure.pi (fun _ => gaussianReal 0 1) from rfl, hint,
      Fintype.prod_prod_type, Fin.prod_univ_two]
    simp only [wt, if_pos rfl, show (1 : Fin 2) ≠ 0 by decide, if_false, Finset.prod_const,
      Finset.card_univ, Fintype.card_fin]
  -- the target side
  have hI01 : IndepFun (fun ω => w0 * X1 ω) (fun ω => w1 * X2 ω) P :=
    hInd.comp (φ := fun y => w0 * y) (ψ := fun y => w1 * y) (by fun_prop) (by fun_prop)
  have hgam1 : ∀ c : ℝ, c < 1 / 2 →
      Integrable (fun ω => Real.exp (c * X1 ω)) P ∧
        ∫ ω, Real.exp (c * X1 ω) ∂P = ∫ x, Real.exp (c * x) ∂(gammaMeasure (35 / 2) (1 / 2)) := by
    intro c hc
    have hm : AEStronglyMeasurable (fun x => Real.exp (c * x)) (P.map X1) := by fun_prop
    constructor
    · have := (integrable_map_measure hm hX1m.aemeasurable).1
        (by rw [hX1]; exact integrable_exp_gamma (by norm_num) (by norm_num) hc)
      exact this
    · rw [← hX1, integral_map hX1m.aemeasurable hm]
  have hgam2 : ∀ c : ℝ, c < 1 / 2 →
      Integrable (fun ω => Real.exp (c * X2 ω)) P ∧
        ∫ ω, Real.exp (c * X2 ω) ∂P = ∫ x, Real.exp (c * x) ∂(gammaMeasure (35 / 2) (1 / 2)) := by
    intro c hc
    have hm : AEStronglyMeasurable (fun x => Real.exp (c * x)) (P.map X2) := by fun_prop
    constructor
    · have := (integrable_map_measure hm hX2m.aemeasurable).1
        (by rw [hX2]; exact integrable_exp_gamma (by norm_num) (by norm_num) hc)
      exact this
    · rw [← hX2, integral_map hX2m.aemeasurable hm]
  have hre : ∀ t c : ℝ, ∀ Y : Ω → ℝ,
      (fun ω => Real.exp (t * (c * Y ω))) = fun ω => Real.exp ((t * c) * Y ω) := by
    intro t c Y; funext ω; rw [mul_assoc]
  have hRint : ∀ t ∈ Ioo (-ε) ε, Integrable (fun x => Real.exp (t * x)) (P.map Z) := by
    intro t ht
    rw [integrable_map_measure (by fun_prop) hZm.aemeasurable]
    have h1 : Integrable (fun ω => Real.exp (t * (w0 * X1 ω))) P := by
      rw [hre]; exact (hgam1 _ (hsmall t ht).1).1
    have h2 : Integrable (fun ω => Real.exp (t * (w1 * X2 ω))) P := by
      rw [hre]; exact (hgam2 _ (hsmall t ht).2).1
    exact hI01.integrable_exp_mul_add h1 h2
  have hRmgf : ∀ t ∈ Ioo (-ε) ε, mgf id (P.map Z) t
      = (∫ x, Real.exp ((t * w0) * x) ∂(gammaMeasure (35 / 2) (1 / 2)))
        * (∫ x, Real.exp ((t * w1) * x) ∂(gammaMeasure (35 / 2) (1 / 2))) := by
    intro t ht
    rw [mgf_id_map hZm.aemeasurable]
    have hZ' : Z = (fun ω => w0 * X1 ω) + (fun ω => w1 * X2 ω) := by
      rw [hZ]; rfl
    rw [hZ', hI01.mgf_add (by fun_prop) (by fun_prop), mgf, mgf, hre, hre,
      (hgam1 _ (hsmall t ht).1).2, (hgam2 _ (hsmall t ht).2).2]
  refine ext_of_mgf_Ioo hεpos hLint hRint fun t ht => ?_
  rw [hLmgf t ht, hRmgf t ht, mgf_chi35 (hsmall t ht).1, mgf_chi35 (hsmall t ht).2]

end KappaInd_ChiSq

section KappaInd_Eig
-- ported verbatim from KappaInd/Eig.lean, sha256 a93059a589b859d62fdabcf3f04d1eae60ea7cfe0971fcae0e6c31032f2ecf0f

/-
The 2×2 spectral data, done by hand with ONE explicit split.

`eig2` produces a unit eigenvector (c, s) of `Gmat θ` for `mu1 θ`.  The split is on
`g01 θ = 0 ∧ g11 θ ≤ g00 θ` — exactly the set where the obvious eigenvector
(g01, mu1 - g00) vanishes (§3 of the statement, "The trap"):
  * inside : mu1 = g00 and (1, 0) works;
  * outside: (g01, mu1 - g00) is nonzero; normalise it.
Then (-s, c) is a unit eigenvector for `mu2 θ` (from mu1 + mu2 = trG), with no
further case split.  No continuity of the choice is needed or claimed: the
eigenvector only enters through the pathwise identity `gram_split` and the
orthonormality `E_orth`, both of which hold for whichever (c, s) was chosen.

The 3-vectors: `aV q = Mᵀ q = (b₀ q₀ + b₁ q₁, q₀, √λ q₁)`, and
`E 0 = aV (c, s) / √mu1`, `E 1 = aV (-s, c) / √mu2`.  On the box (0 < mu2 ≤ mu1):
  * `E_orth`    : ∑ k, E j k * E j' k = [j = j']
  * `gram_split`: ∑ i, (M v)_i² = mu1 (E 0 · v)² + mu2 (E 1 · v)²
-/

open MeasureTheory ProbabilityTheory Set



theorem discG_eq (θ : Param) : discG θ = (g00 θ - g11 θ) ^ 2 + 4 * g01 θ ^ 2 := by
  unfold discG trG detG; ring

theorem discG_nonneg (θ : Param) : 0 ≤ discG θ := by
  rw [discG_eq]; positivity

theorem sqrt_discG_sq (θ : Param) : Real.sqrt (discG θ) ^ 2 = discG θ :=
  Real.sq_sqrt (discG_nonneg θ)

theorem mu_sum (θ : Param) : mu1 θ + mu2 θ = trG θ := by
  unfold mu1 mu2; ring

theorem mu_prod (θ : Param) : mu1 θ * mu2 θ = detG θ := by
  have h := sqrt_discG_sq θ
  have hd : discG θ = trG θ ^ 2 - 4 * detG θ := rfl
  unfold mu1 mu2
  linear_combination (-1 / 4 : ℝ) * h + (-1 / 4 : ℝ) * hd

theorem mu1_charQ (θ : Param) : (mu1 θ - g00 θ) * (mu1 θ - g11 θ) = g01 θ ^ 2 := by
  have h := sqrt_discG_sq θ
  have hd : discG θ = (g00 θ + g11 θ) ^ 2 - 4 * (g00 θ * g11 θ - g01 θ ^ 2) := rfl
  unfold mu1 trG
  linear_combination (1 / 4 : ℝ) * h + (1 / 4 : ℝ) * hd

theorem detG_pos {θ : Param} (hθ : θ ∈ Box) : 0 < detG θ := by
  have hl := lam_pos hθ
  have : detG θ = θ.2.1 ^ 2 * θ.1 + θ.2.2 ^ 2 + θ.1 := by
    unfold detG g00 g11 g01; ring
  rw [this]; positivity

theorem trG_pos {θ : Param} (hθ : θ ∈ Box) : 0 < trG θ := by
  have hl := lam_pos hθ
  unfold trG g00 g11; positivity

theorem mu2_pos {θ : Param} (hθ : θ ∈ Box) : 0 < mu2 θ := by
  have ht := trG_pos hθ
  have hd := detG_pos hθ
  have hlt : Real.sqrt (discG θ) < trG θ := by
    rw [Real.sqrt_lt' ht]
    unfold discG; nlinarith
  unfold mu2; linarith

theorem mu1_pos {θ : Param} (hθ : θ ∈ Box) : 0 < mu1 θ := by
  have ht := trG_pos hθ
  have := Real.sqrt_nonneg (discG θ)
  unfold mu1; linarith

/-- A unit eigenvector of `Gmat θ` for `mu1 θ`, componentwise.  One explicit split. -/
theorem eig2 (θ : Param) : ∃ c s : ℝ, c ^ 2 + s ^ 2 = 1 ∧
    g00 θ * c + g01 θ * s = mu1 θ * c ∧ g01 θ * c + g11 θ * s = mu1 θ * s := by
  by_cases hin : g01 θ = 0 ∧ g11 θ ≤ g00 θ
  · -- inside: mu1 = g00, eigenvector (1, 0)
    have hd : discG θ = (g00 θ - g11 θ) ^ 2 := by rw [discG_eq, hin.1]; ring
    have hmu : mu1 θ = g00 θ := by
      unfold mu1; rw [hd, Real.sqrt_sq (by linarith [hin.2])]; unfold trG; ring
    refine ⟨1, 0, by norm_num, ?_, ?_⟩
    · rw [hmu, hin.1]; ring
    · rw [hmu, hin.1]; ring
  · -- outside: (g01, mu1 - g00) is nonzero
    have hpos : 0 < g01 θ ^ 2 + (mu1 θ - g00 θ) ^ 2 := by
      by_cases h0 : g01 θ = 0
      · have hlt : g00 θ < g11 θ := by
          by_contra hc
          exact hin ⟨h0, le_of_not_gt hc⟩
        have hd : discG θ = (g11 θ - g00 θ) ^ 2 := by rw [discG_eq, h0]; ring
        have hmu : mu1 θ = g11 θ := by
          unfold mu1; rw [hd, Real.sqrt_sq (by linarith)]; unfold trG; ring
        rw [hmu, h0]
        have : 0 < (g11 θ - g00 θ) ^ 2 := by
          have : g11 θ - g00 θ ≠ 0 := by linarith
          positivity
        linarith
      · have h1 : 0 < g01 θ ^ 2 := lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 h0))
        have h2 := sq_nonneg (mu1 θ - g00 θ)
        linarith
    set r := Real.sqrt (g01 θ ^ 2 + (mu1 θ - g00 θ) ^ 2) with hr
    have hrpos : 0 < r := Real.sqrt_pos.mpr hpos
    refine ⟨g01 θ / r, (mu1 θ - g00 θ) / r, ?_, ?_, ?_⟩
    · rw [div_pow, div_pow, ← add_div, hr, Real.sq_sqrt hpos.le, div_self hpos.ne']
    · ring
    · have key : g01 θ * g01 θ + g11 θ * (mu1 θ - g00 θ) = mu1 θ * (mu1 θ - g00 θ) := by
        linear_combination (-1 : ℝ) * mu1_charQ θ
      calc g01 θ * (g01 θ / r) + g11 θ * ((mu1 θ - g00 θ) / r)
          = (g01 θ * g01 θ + g11 θ * (mu1 θ - g00 θ)) / r := by ring
        _ = (mu1 θ * (mu1 θ - g00 θ)) / r := by rw [key]
        _ = mu1 θ * ((mu1 θ - g00 θ) / r) := by ring

/-- The rotated vector (-s, c) is an eigenvector for `mu2 θ`. -/
theorem eig2_second {θ : Param} {c s : ℝ}
    (h1 : g00 θ * c + g01 θ * s = mu1 θ * c) (h2 : g01 θ * c + g11 θ * s = mu1 θ * s) :
    g00 θ * (-s) + g01 θ * c = mu2 θ * (-s) ∧ g01 θ * (-s) + g11 θ * c = mu2 θ * c := by
  have hm2 : mu2 θ = g00 θ + g11 θ - mu1 θ := by
    have := mu_sum θ; unfold trG at this; linarith
  rw [hm2]
  constructor
  · linear_combination h2
  · linear_combination (-1 : ℝ) * h1

/-- A 3-vector by components. -/
def v3 (x y w : ℝ) : Fin 3 → ℝ := fun k => if k = 0 then x else if k = 1 then y else w

@[simp] theorem v3_zero (x y w : ℝ) : v3 x y w 0 = x := by simp [v3]
@[simp] theorem v3_one (x y w : ℝ) : v3 x y w 1 = y := by simp [v3]
@[simp] theorem v3_two (x y w : ℝ) : v3 x y w 2 = w := by simp [v3]

/-- `Mᵀ q` for `q = (q₀, q₁)`. -/
def aV (θ : Param) (q0 q1 : ℝ) : Fin 3 → ℝ :=
  v3 (θ.2.1 * q0 + θ.2.2 * q1) q0 (Real.sqrt θ.1 * q1)

theorem aV_dot (θ : Param) (q0 q1 : ℝ) (v : Fin 3 → ℝ) :
    ∑ k, aV θ q0 q1 k * v k
      = q0 * Matrix.mulVec (Mmat θ) v 0 + q1 * Matrix.mulVec (Mmat θ) v 1 := by
  rw [mulVec_row0, mulVec_row1, Fin.sum_univ_three]
  simp only [aV, v3_zero, v3_one, v3_two]
  ring

/-- `|Mᵀ q|² = qᵀ G q`, on the box. -/
theorem aV_norm {θ : Param} (hθ : θ ∈ Box) (q0 q1 : ℝ) :
    ∑ k, aV θ q0 q1 k ^ 2 = q0 * (g00 θ * q0 + g01 θ * q1) + q1 * (g01 θ * q0 + g11 θ * q1) := by
  have hl := (lam_pos hθ).le
  rw [Fin.sum_univ_three]
  simp only [aV, v3_zero, v3_one, v3_two]
  rw [mul_pow, Real.sq_sqrt hl]
  unfold g00 g11 g01
  ring

/-- `(Mᵀ q) · (Mᵀ q') = qᵀ G q'`, on the box. -/
theorem aV_inner {θ : Param} (hθ : θ ∈ Box) (q0 q1 p0 p1 : ℝ) :
    ∑ k, aV θ q0 q1 k * aV θ p0 p1 k
      = q0 * (g00 θ * p0 + g01 θ * p1) + q1 * (g01 θ * p0 + g11 θ * p1) := by
  have hl := (lam_pos hθ).le
  rw [Fin.sum_univ_three]
  simp only [aV, v3_zero, v3_one, v3_two]
  have : Real.sqrt θ.1 * q1 * (Real.sqrt θ.1 * p1) = θ.1 * q1 * p1 := by
    rw [show Real.sqrt θ.1 * q1 * (Real.sqrt θ.1 * p1) = Real.sqrt θ.1 ^ 2 * q1 * p1 by ring,
      Real.sq_sqrt hl]
  rw [this]
  unfold g00 g11 g01
  ring

/-- The two unit directions in ℝ³ (rows of the eigen-rotated Gram factor). -/
def E (θ : Param) (c s : ℝ) (j : Fin 2) : Fin 3 → ℝ :=
  if j = 0 then fun k => aV θ c s k / Real.sqrt (mu1 θ)
  else fun k => aV θ (-s) c k / Real.sqrt (mu2 θ)

theorem E_zero (θ : Param) (c s : ℝ) (k : Fin 3) :
    E θ c s 0 k = aV θ c s k / Real.sqrt (mu1 θ) := by simp [E]

theorem E_one (θ : Param) (c s : ℝ) (k : Fin 3) :
    E θ c s 1 k = aV θ (-s) c k / Real.sqrt (mu2 θ) := by simp [E]

section eigvec

variable {θ : Param} {c s : ℝ} (hθ : θ ∈ Box) (hcs : c ^ 2 + s ^ 2 = 1)
  (h1 : g00 θ * c + g01 θ * s = mu1 θ * c) (h2 : g01 θ * c + g11 θ * s = mu1 θ * s)
include hθ hcs h1 h2

/-- The directions `E 0`, `E 1` are orthonormal in ℝ³. -/
theorem E_orth (j j' : Fin 2) : ∑ k, E θ c s j k * E θ c s j' k = if j = j' then 1 else 0 := by
  have hm1 := mu1_pos hθ
  have hm2 := mu2_pos hθ
  have hr1 : Real.sqrt (mu1 θ) ^ 2 = mu1 θ := Real.sq_sqrt hm1.le
  have hr2 : Real.sqrt (mu2 θ) ^ 2 = mu2 θ := Real.sq_sqrt hm2.le
  have hs1 : 0 < Real.sqrt (mu1 θ) := Real.sqrt_pos.mpr hm1
  have hs2 : 0 < Real.sqrt (mu2 θ) := Real.sqrt_pos.mpr hm2
  obtain ⟨h3, h4⟩ := eig2_second h1 h2
  have hdiv : ∀ (x y : Fin 3 → ℝ) (a b : ℝ),
      ∑ k, x k / a * (y k / b) = (∑ k, x k * y k) / (a * b) := by
    intro x y a b
    rw [Finset.sum_div]
    exact Finset.sum_congr rfl fun k _ => by ring
  fin_cases j <;> fin_cases j'
  · simp only [Fin.zero_eta, Fin.isValue, E_zero, if_true]
    rw [hdiv, aV_inner hθ, h1, h2, ← sq, hr1]
    field_simp
    linear_combination hcs
  · simp only [Fin.zero_eta, Fin.isValue, Fin.mk_one, E_zero, E_one,
      show (0 : Fin 2) ≠ 1 by decide, if_false]
    rw [hdiv, aV_inner hθ, h3, h4]
    field_simp
    ring
  · simp only [Fin.zero_eta, Fin.isValue, Fin.mk_one, E_zero, E_one,
      show (1 : Fin 2) ≠ 0 by decide, if_false]
    rw [hdiv, aV_inner hθ, h1, h2]
    field_simp
    ring
  · simp only [Fin.isValue, Fin.mk_one, E_one, if_true]
    rw [hdiv, aV_inner hθ, h3, h4, ← sq, hr2]
    field_simp
    linear_combination hcs

/-- Pathwise: the Gram form splits along the eigen-directions. -/
theorem gram_split (v : Fin 3 → ℝ) :
    ∑ i, (Matrix.mulVec (Mmat θ) v i) ^ 2
      = mu1 θ * (∑ k, E θ c s 0 k * v k) ^ 2 + mu2 θ * (∑ k, E θ c s 1 k * v k) ^ 2 := by
  have hm1 := mu1_pos hθ
  have hm2 := mu2_pos hθ
  have hr1 : Real.sqrt (mu1 θ) ^ 2 = mu1 θ := Real.sq_sqrt hm1.le
  have hr2 : Real.sqrt (mu2 θ) ^ 2 = mu2 θ := Real.sq_sqrt hm2.le
  have hs1 : 0 < Real.sqrt (mu1 θ) := Real.sqrt_pos.mpr hm1
  have hs2 : 0 < Real.sqrt (mu2 θ) := Real.sqrt_pos.mpr hm2
  have hd : ∀ (x : Fin 3 → ℝ) (a : ℝ), ∑ k, x k / a * v k = (∑ k, x k * v k) / a := by
    intro x a
    rw [Finset.sum_div]
    exact Finset.sum_congr rfl fun k _ => by ring
  simp only [E_zero, E_one]
  rw [hd, hd, aV_dot, aV_dot, div_pow, div_pow, hr1, hr2, Fin.sum_univ_two]
  field_simp
  linear_combination (-(Matrix.mulVec (Mmat θ) v 0 ^ 2 + Matrix.mulVec (Mmat θ) v 1 ^ 2)) * hcs

end eigvec

end KappaInd_Eig

section KappaInd_K7
-- ported verbatim from KappaInd/K7.lean, sha256 55897c001a13ac58fcc2b7a091dfa5fed13b90fc94bb839e9d54dc293d80fcff

/-
K-7: `panelLaw.map (Sres m θ) = P.map (fun ω => mu1 θ * X1 ω + mu2 θ * X2 ω)`.

Route: the eigen-SPLIT route for the pathwise algebra (one explicit split, inside
`eig2`), and the basis-free MGF route for the law identification (`chi_mix_law`,
which never sees an eigenvector).

Given the time rotation `O` (Rot36) and a unit eigenvector (c, s) (Eig), put
  V(j, s)(z) = ∑_{k,t} O (s+1) t · E j k · z (k, t),   (j, s) ∈ Fin 2 × Fin 35.
* `VCoef_orth`: the 70 coefficient vectors are orthonormal in ℝ^{PanelIdx}, so by the
  engine (`lin_family_map_eq`) `panelLaw.map V = stdPi (Fin 2 × Fin 35)`.
* `Sres_eq_V` (pathwise, every m, every z):
    Sres = Σ_t |M zc_t|²                              (K-2)
         = Σ_t mu1 (E0·zc_t)² + mu2 (E1·zc_t)²          (gram_split)
         = mu1 Σ_t (W₀ t - W̄₀)² + mu2 Σ_t (W₁ t - W̄₁)²,   W_j t = E j · z(·,t)
         = mu1 Σ_s V(0,s)² + mu2 Σ_s V(1,s)²             (rot_css, pathwise Cochran)
* then `Measure.map_map` and `chi_mix_law` with weights (mu1 θ, mu2 θ).
-/

open MeasureTheory ProbabilityTheory Set



/-- Coefficient of the rotated eigen-coordinate `V (j, s)` on panel entry `(k, t)`. -/
def VCoef (O : Fin 36 → Fin 36 → ℝ) (θ : Param) (c s : ℝ) (p : Fin 2 × Fin 35)
    (q : PanelIdx) : ℝ :=
  O p.2.succ q.2 * E θ c s p.1 q.1

/-- `IsRot36` restated with sums over `Fin nObs` (definitionally `Fin 36`). -/
theorem rot_rows_n {O : Fin 36 → Fin 36 → ℝ} (hO : IsRot36 O) (a b : Fin 36) :
    ∑ t : Fin nObs, O a t * O b t = if a = b then 1 else 0 := hO.2 a b

theorem rot_css_n {O : Fin 36 → Fin 36 → ℝ} (hO : IsRot36 O) (x : Fin nObs → ℝ) :
    ∑ t : Fin nObs, (x t - (∑ t', x t') / 36) ^ 2
      = ∑ s : Fin 35, (∑ t : Fin nObs, O s.succ t * x t) ^ 2 := rot_css hO x

section spectral

variable {O : Fin 36 → Fin 36 → ℝ} {θ : Param} {c s : ℝ} (hO : IsRot36 O) (hθ : θ ∈ Box)
  (hcs : c ^ 2 + s ^ 2 = 1)
  (h1 : g00 θ * c + g01 θ * s = mu1 θ * c) (h2 : g01 θ * c + g11 θ * s = mu1 θ * s)

include hO hθ hcs h1 h2 in
/-- The 70 rotated eigen-coordinates are orthonormal linear forms of the panel. -/
theorem VCoef_orth (p p' : Fin 2 × Fin 35) :
    ∑ q, VCoef O θ c s p q * VCoef O θ c s p' q = if p = p' then 1 else 0 := by
  have hsplit : ∀ q : PanelIdx, VCoef O θ c s p q * VCoef O θ c s p' q
      = (E θ c s p.1 q.1 * E θ c s p'.1 q.1) * (O p.2.succ q.2 * O p'.2.succ q.2) := by
    intro q; simp only [VCoef]; ring
  simp_rw [hsplit]
  rw [Fintype.sum_prod_type]
  simp_rw [← Finset.mul_sum]
  rw [← Finset.sum_mul, rot_rows_n hO, E_orth hθ hcs h1 h2]
  obtain ⟨j, a⟩ := p
  obtain ⟨j', a'⟩ := p'
  simp only [Fin.succ_inj, Prod.mk.injEq]
  by_cases hj : j = j' <;> by_cases ha : a = a' <;> simp [hj, ha]

/-- The time-mean form of a centred eigen-coordinate. -/
theorem E_dot_zc (j : Fin 2) (z : Panel) (t : Fin nObs) :
    ∑ k, E θ c s j k * zc z t k
      = (∑ k, E θ c s j k * z (k, t))
        - (∑ t', ∑ k, E θ c s j k * z (k, t')) / 36 := by
  simp only [zc, sMean, mul_sub, Finset.sum_sub_distrib]
  rw [Finset.sum_comm (f := fun t' k => E θ c s j k * z (k, t'))]
  rw [Finset.sum_div]
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [show (nObs : ℝ) = 36 by norm_num [nObs], ← Finset.mul_sum]
  ring

/-- The rotated form of a time-coordinate is the linear form `lin (VCoef ...)`. -/
theorem lin_VCoef (j : Fin 2) (a : Fin 35) (z : Panel) :
    lin (VCoef O θ c s (j, a)) z = ∑ t : Fin nObs, O a.succ t * ∑ k, E θ c s j k * z (k, t) := by
  simp only [lin, VCoef, Fintype.sum_prod_type]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun k _ => by ring

include hO hθ hcs h1 h2 in
/-- Pathwise, for every `m`: Sres is the weighted sum of squared rotated eigen-coordinates. -/
theorem Sres_eq_V (m : ℝ) :
    Sres m θ = (fun x : Fin 2 × Fin 35 → ℝ =>
        mu1 θ * ∑ a, x (0, a) ^ 2 + mu2 θ * ∑ a, x (1, a) ^ 2)
      ∘ (fun z p => lin (VCoef O θ c s p) z) := by
  funext z
  simp only [Function.comp]
  rw [Sres_eq_gram_form]
  simp_rw [gram_split hθ hcs h1 h2]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
  have hkey : ∀ j : Fin 2, ∑ t : Fin nObs, (∑ k, E θ c s j k * zc z t k) ^ 2
      = ∑ a : Fin 35, (lin (VCoef O θ c s (j, a)) z) ^ 2 := by
    intro j
    simp_rw [E_dot_zc j z, lin_VCoef]
    exact rot_css_n hO (fun t => ∑ k, E θ c s j k * z (k, t))
  rw [hkey 0, hkey 1]

end spectral

/-- K-7: S =_d μ₁ X₁ + μ₂ X₂, X_j iid χ²_ν central. -/
theorem kappa_spectral {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {X1 X2 : Ω → ℝ} (hX1m : Measurable X1) (hX2m : Measurable X2)
    (hX1 : P.map X1 = gammaMeasure (35 / 2) (1 / 2))
    (hX2 : P.map X2 = gammaMeasure (35 / 2) (1 / 2))
    (hInd : IndepFun X1 X2 P) (m : ℝ) {θ : Param} (hθ : θ ∈ Box) :
    panelLaw.map (Sres m θ) = P.map (fun ω => mu1 θ * X1 ω + mu2 θ * X2 ω) := by
  obtain ⟨O, hO⟩ := exists_rot36
  obtain ⟨c, s, hcs, h1, h2⟩ := eig2 θ
  have hV : Measurable (fun z : Panel => fun p => lin (VCoef O θ c s p) z) :=
    measurable_pi_iff.mpr (fun p => lin_measurable _)
  have hF : Measurable (fun x : Fin 2 × Fin 35 → ℝ =>
      mu1 θ * ∑ a, x (0, a) ^ 2 + mu2 θ * ∑ a, x (1, a) ^ 2) := by fun_prop
  rw [Sres_eq_V hO hθ hcs h1 h2 m, ← Measure.map_map hF hV, panelLaw_eq,
    lin_family_map_eq (VCoef O θ c s) (VCoef_orth hO hθ hcs h1 h2)]
  exact chi_mix_law hX1m hX2m hX1 hX2 hInd (mu1 θ) (mu2 θ)

end KappaInd_K7

section KappaInd_Assembly
-- ported verbatim from KappaInd/Assembly.lean, sha256 fbce57afb2d39e0dce560905015d917d3a90dd23b38689ec741d9be898c31f67

/-
Assembly: K-3, the two pairwise consequences of `hInd`, and `kappa_reduction`.

K-3 (`Sres_pos_ae`): from the pathwise `Sres = F ∘ V` (K7) with `panelLaw.map V = stdPi`,
`Sres ≤ 0` forces `V (0,0) = 0` (as 0 < mu2 ≤ mu1), a null event for N(0,1).

`kappa_reduction`: for c > 0 and θ ∈ Box,
  {c < Tstat} =ᵃᵉ (Nstd, Sres)⁻¹' A,   A = {p | c √(p.2 / (nu aF)) < p.1}      (K-3, K-4)
  panelLaw.map (Nstd, Sres) = N(0,1) ⊗ panelLaw.map Sres                        (K-6)
                            = N(0,1) ⊗ P.map (mu1 X1 + mu2 X2)                  (K-5, K-7)
                            = P.map (N, mu1 X1 + mu2 X2)                         (hN, hInd)
and `(r1 X1 + r2 X2)/nu = (mu1 X1 + mu2 X2)/(nu aF)` pointwise (aF ≠ 0).
-/

open MeasureTheory ProbabilityTheory Set



instance panelLaw_isProb : IsProbabilityMeasure panelLaw := by
  rw [panelLaw_eq]; infer_instance

/-- K-3: S > 0 almost surely. -/
theorem Sres_pos_ae (m : ℝ) {θ : Param} (hθ : θ ∈ Box) :
    ∀ᵐ z ∂panelLaw, 0 < Sres m θ z := by
  obtain ⟨O, hO⟩ := exists_rot36
  obtain ⟨c, s, hcs, h1, h2⟩ := eig2 θ
  have hV : Measurable (fun z : Panel => fun p => lin (VCoef O θ c s p) z) :=
    measurable_pi_iff.mpr (fun p => lin_measurable _)
  have hlaw : panelLaw.map (fun z : Panel => fun p => lin (VCoef O θ c s p) z)
      = stdPi (Fin 2 × Fin 35) := by
    rw [panelLaw_eq]; exact lin_family_map_eq _ (VCoef_orth hO hθ hcs h1 h2)
  have hS := Sres_eq_V hO hθ hcs h1 h2 m
  have hm1 := mu1_pos hθ
  have hm2 := mu2_pos hθ
  rw [ae_iff]
  have hsub : {z | ¬ 0 < Sres m θ z}
      ⊆ (fun z : Panel => fun p => lin (VCoef O θ c s p) z) ⁻¹'
          ((fun x : Fin 2 × Fin 35 → ℝ => x (0, 0)) ⁻¹' {0}) := by
    intro z hz
    simp only [mem_setOf_eq, not_lt] at hz
    rw [hS, Function.comp_apply] at hz
    simp only [mem_preimage, mem_singleton_iff]
    set y : Fin 2 × Fin 35 → ℝ := fun p => lin (VCoef O θ c s p) z
    have hA : y (0, 0) ^ 2 ≤ ∑ a, y (0, a) ^ 2 :=
      Finset.single_le_sum (f := fun a => y (0, a) ^ 2) (fun a _ => sq_nonneg _)
        (Finset.mem_univ 0)
    have hB : 0 ≤ ∑ a, y (1, a) ^ 2 := Finset.sum_nonneg (fun a _ => sq_nonneg _)
    have h0 : y (0, 0) ^ 2 ≤ 0 := by nlinarith
    exact pow_eq_zero_iff (two_ne_zero) |>.mp (le_antisymm h0 (sq_nonneg _))
  refine measure_mono_null hsub ?_
  rw [← Measure.map_apply hV ((measurable_pi_apply _) (measurableSet_singleton 0)), hlaw,
    ← Measure.map_apply (measurable_pi_apply _) (measurableSet_singleton 0), stdPi_map_eval]
  haveI := nullSingletonClass_gaussianReal (μ := 0) (v := 1) one_ne_zero
  exact measure_singleton 0

/-- The two pairwise consequences of `hInd` that the target needs. -/
theorem hInd_pair {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {N X1 X2 : Ω → ℝ} (hNm : Measurable N) (hX1m : Measurable X1) (hX2m : Measurable X2)
    (hInd : iIndepFun ![N, X1, X2] P) (a b : ℝ) :
    IndepFun X1 X2 P ∧ IndepFun N (fun ω => a * X1 ω + b * X2 ω) P := by
  refine ⟨hInd.indepFun (i := 1) (j := 2) (by decide), ?_⟩
  have hmeas : ∀ i, Measurable (![N, X1, X2] i) := by
    intro i
    fin_cases i
    · exact hNm
    · exact hX1m
    · exact hX2m
  have h := hInd.indepFun_finset {0} {1, 2} (by decide) hmeas
  have hφ : Measurable (fun g : ({0} : Finset (Fin 3)) → ℝ => g ⟨0, by simp⟩) :=
    measurable_pi_apply _
  have hψ : Measurable (fun g : ({1, 2} : Finset (Fin 3)) → ℝ =>
      a * g ⟨1, by simp⟩ + b * g ⟨2, by simp⟩) := by fun_prop
  exact h.comp hφ hψ

theorem Nstd_measurable (m : ℝ) (θ : Param) : Measurable (Nstd m θ) := by
  rw [Nstd_eq_lin]; exact lin_measurable _

theorem Sres_measurable (m : ℝ) (θ : Param) : Measurable (Sres m θ) := by
  rw [Sres_eq_gramOf]
  exact (gramOf_measurable θ).comp (measurable_pi_iff.mpr fun q => lin_measurable _)

theorem kappa_reduction {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {N X1 X2 : Ω → ℝ} (hNm : Measurable N) (hX1m : Measurable X1) (hX2m : Measurable X2)
    (hN : P.map N = gaussianReal 0 1)
    (hX1 : P.map X1 = gammaMeasure (35 / 2) (1 / 2))
    (hX2 : P.map X2 = gammaMeasure (35 / 2) (1 / 2))
    (hInd : iIndepFun ![N, X1, X2] P) (m : ℝ) :
    ∀ c, 0 < c → ∀ θ ∈ Box, RawRate m c θ = Phi P N X1 X2 c (r1 θ) (r2 θ) := by
  intro c hc θ hθ
  obtain ⟨h12, hNW⟩ := hInd_pair hNm hX1m hX2m hInd (mu1 θ) (mu2 θ)
  have hWm : Measurable (fun ω => mu1 θ * X1 ω + mu2 θ * X2 ω) := by fun_prop
  have hAm : MeasurableSet {p : ℝ × ℝ | c * Real.sqrt (p.2 / (nu * aF θ)) < p.1} :=
    measurableSet_lt (by fun_prop) measurable_fst
  have hNs := Nstd_measurable m θ
  have hSs := Sres_measurable m θ
  -- the rejection event is a.e. the preimage of the fixed set under (Nstd, Sres)
  have hev : {z | c < Tstat m θ z}
      =ᵐ[panelLaw] (fun z => (Nstd m θ z, Sres m θ z)) ⁻¹'
        {p : ℝ × ℝ | c * Real.sqrt (p.2 / (nu * aF θ)) < p.1} := by
    filter_upwards [Sres_pos_ae m hθ] with z hz
    exact propext (kappa_event hθ hc hz)
  have hpanel : panelLaw {z | c < Tstat m θ z}
      = ((gaussianReal 0 1).prod (P.map (fun ω => mu1 θ * X1 ω + mu2 θ * X2 ω)))
          {p : ℝ × ℝ | c * Real.sqrt (p.2 / (nu * aF θ)) < p.1} := by
    rw [measure_congr hev, ← Measure.map_apply (hNs.prodMk hSs) hAm,
      (indepFun_iff_map_prod_eq_prod_map_map hNs.aemeasurable hSs.aemeasurable).1
        (kappa_indep m hθ),
      kappa_numerator_law m hθ, kappa_spectral hX1m hX2m hX1 hX2 h12 m hθ]
  have hP : P {ω | c * Real.sqrt ((r1 θ * X1 ω + r2 θ * X2 ω) / nu) < N ω}
      = ((gaussianReal 0 1).prod (P.map (fun ω => mu1 θ * X1 ω + mu2 θ * X2 ω)))
          {p : ℝ × ℝ | c * Real.sqrt (p.2 / (nu * aF θ)) < p.1} := by
    rw [← hN, ← (indepFun_iff_map_prod_eq_prod_map_map hNm.aemeasurable hWm.aemeasurable).1 hNW,
      Measure.map_apply (hNm.prodMk hWm) hAm]
    congr 1
    ext ω
    simp only [mem_setOf_eq, mem_preimage]
    have ha := (aF_pos hθ).ne'
    have hnu : nu ≠ 0 := by norm_num [nu]
    rw [show (r1 θ * X1 ω + r2 θ * X2 ω) / nu
        = (mu1 θ * X1 ω + mu2 θ * X2 ω) / (nu * aF θ) by
      unfold r1 r2; field_simp]
  unfold RawRate Phi
  rw [hpanel, hP]

/-- K-2 with the exact statement text (Step4's `Sres_eq_gram_form` writes the same
term as `(Matrix.mulVec (Mmat θ) (zc z t)) i ^ 2`; this checks the two parse identically). -/
theorem Sres_eq_gram_form_verbatim (m : ℝ) (θ : Param) (z : Panel) :
    Sres m θ z = ∑ t, ∑ i, (Matrix.mulVec (Mmat θ) (zc z t) i) ^ 2 := Sres_eq_gram_form m θ z

end KappaInd_Assembly

end Unit2B.FormalR1.Kappa.ProofsR10
