import ExactManyToOne.Calibrated

/-!
# The deposited certificates, checked exactly

Generated by `scripts/gen_certificates.py` from the JSON deposits. Do not edit by
hand. Each number is the exact binary value of the deposited float.

The enclosures themselves are computed in Python with interval arithmetic in
directed rounding and are not recomputed here. Their outputs enter as the
hypotheses named `hcert`. What Lean checks is that each output supports the claim
the paper makes from it, and that each pass/fail label is the right one.
-/

-- exact binary rationals do not fit in 100 columns
set_option linter.style.longLine false

open MeasureTheory
open scoped ENNReal

namespace ExactManyToOne.Certificates

/-- Moving a real certificate inequality into the extended nonnegative reals. -/
lemma ennreal_bound {m : ℕ} {b a : ℝ} (h : (m : ℝ) * b ≤ a) :
    (m : ℝ≥0∞) * ENNReal.ofReal b ≤ ENNReal.ofReal a := by
  rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
  exact ENNReal.ofReal_le_ofReal h

